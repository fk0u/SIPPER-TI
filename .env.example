# Salin menjadi .env.local lalu isi dari Supabase Dashboard > Project Settings > API Keys.
# Jika dua variabel publik ini kosong, aplikasi berjalan dalam MODE DEMO (data lokal browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). NEXT_PUBLIC_SUPABASE_ANON_KEY lama juga didukung.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RAHASIA — hanya untuk scripts/seed-auth-users.mjs. Jangan diberi prefix NEXT_PUBLIC_
# dan jangan dipakai di kode aplikasi.
SUPABASE_SECRET_KEY=
